# ==============================================================================
# Servidor MCP Privado STEOS v4.53.2 — Variáveis de Ambiente
# Copie este arquivo para mcp-server/.env e preencha os segredos reais.
# NUNCA versione o arquivo .env com credenciais reais.
# ==============================================================================

# Porta do servidor HTTP (Streamable HTTP + SSE legado)
PORT=3001
NODE_ENV=development

# URL base da aplicação STEOS PHP/API v1
# Local: http://localhost:8080 | Produção Docker (rede steos): http://steos
STEOS_BASE_URL=http://localhost:8080

# Usuário de serviço (staff) na API v1 do STEOS para o escopo /mcp/admin
STEOS_SERVICE_EMAIL=mcp.service@stesistemas.com
STEOS_SERVICE_PASSWORD=

# Segredo compartilhado com o backend PHP para POST /index.php/api/v1/client/auth-bot
STEOS_BOT_SECRET=

# Chaves de API do servidor MCP (OBRIGATÓRIO em --streamable-http)
# Use valores aleatórios de alta entropia (mínimo 16 caracteres) e DIFERENTES entre si
MCP_ADMIN_API_KEY=
MCP_CLIENT_API_KEY=

# Feature flags de controle de escrita
# Escrita operacional (criar/editar O.S., anotações, itens, criar cliente)
MCP_ENABLE_WRITE=true
# Escrita fiscal crítica (emissão e cancelamento de NFS-e no Asaas)
MCP_ENABLE_FISCAL_WRITE=false

# Origens permitidas no CORS (* ou lista separada por vírgula)
MCP_CORS_ORIGIN=*

# Limite de requisições por minuto por IP + escopo
MCP_RATE_LIMIT_PER_MIN=120
