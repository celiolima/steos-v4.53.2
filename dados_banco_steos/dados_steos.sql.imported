tom: 1px solid #ddd;\n            font-weight: bold;\n        }\n\n        .invoice-box table tr.details td {\n            padding-bottom: 20px;\n        }\n\n        .invoice-box table tr.item td {\n            border-bottom: 1px solid #eee;\n        }\n\n        .invoice-box table tr.item.last td {\n            border-bottom: none;\n        }\n\n        .invoice-box table tr.total td:nth-child(2) {\n            border-top: 2px solid #eee;\n            font-weight: bold;\n        }\n\n        @media only screen and (max-width: 600px) {\n            .invoice-box table tr.top table td {\n                width: 100%;\n                display: block;\n                text-align: center;\n            }\n\n            .invoice-box table tr.information table td {\n                width: 100%;\n                display: block;\n                text-align: center;\n            }\n        }\n\n        /** RTL **/\n        .rtl {\n            direction: rtl;\n            font-family: Tahoma, \'Helvetica Neue\', \'Helvetica\', Helvetica, Arial, sans-serif;\n        }\n\n        .rtl table {\n            text-align: right;\n        }\n\n        .rtl table tr td:nth-child(2) {\n            text-align: left;\n        }\n\n        .justify {\n            text-align: justify;\n        }\n    </style>\n</head>\n\n<body>\n    <div class=\"invoice-box\">\n        <table cellpadding=\"0\" cellspacing=\"0\">\n            <tr class=\"top\">\n                <td colspan=\"4\">\n                    <table>\n                        <tr>\n                            <td class=\"title\">\n                                <img src=\"https://steos.stesistemas.com/assets/uploads/bf2aa27b8cc00c880d41bea19ef26184.png\" style=\"width:100%; max-width:120px;\">\n                            </td>\n                            <td style=\"text-align: right\">\n                                OS #: 2524<br>\n                                Data Inicial: 08/07/2026 <br>\n                                Data Final: 08/07/2026                            </td>\n                        </tr>\n                    </table>\n                </td>\n            </tr>\n\n            <tr class=\"information\">\n                <td colspan=\"4\">\n                    <table>\n                        <tr>\n                            <td>\n                                Cliente: CONDOMINIO EDIFICIO SUELY<br>\n                                Rua João Cordeiro, 150, Praia de Iracema<br>\n                                FORTALEZA - Ceará <br>\n                                felipe.bvo@gmail.com <br>\n                                                            </td>\n\n                            <td style=\"text-align: right\">\n                                STE SISTEMAS <br>\n                                Rua NOGUEIRA ACIOLI, 367, Centro<br>\n                                Fortaleza - CE CEP: 60135-270 <br>\n                                Responsável: celiolima                            </td>\n                        </tr>\n                    </table>\n                </td>\n            </tr>\n\n            <tr class=\"heading\">\n                <td colspan=\"2\">\n                    Status\n                </td>\n                <td colspan=\"2\" style=\"text-align: center\">\n                    Negociação                </td>\n            </tr>\n\n            \n            \n            \n                            <tr class=\"heading\">\n                    <td colspan=\"4\">\n                        <b>Observações</b>\n                    </td>\n                </tr>\n                <tr>\n                    <td class=\"justify\" colspan=\"4\">\n                        <p class=\"MsoNormal\" style=\"margin-top:14pt;margin-right:0cm;margin-bottom:8pt;margin-left:0cm;\"><span style=\"font-size:18.6667px;font-weight:700;\">01 PORTEIRO COLETIVO ALFANUMERICO 4G</span></p><p class=\"MsoNormal\" style=\"margin:6pt 0cm 8pt;line-height:16.8px;\"><span style=\"font-weight:700;\"><span style=\"font-size:12pt;line-height:22.4px;\">Equipamentos → PORTEIRO PEC 1310, ELETROIMÃ E BOTÃO DE SAIDA E MOLA ÁEREA</span></span></p><p class=\"MsoNormal\" style=\"margin:6pt 0cm 8pt;line-height:16.8px;\"><span style=\"font-weight:700;\"><span style=\"font-size:12pt;line-height:22.4px;\">Visão Geral do Projeto</span></span></p><p style=\"margin:0px 0px 1rem;background-color:rgb(255,255,255);\">Este item contempla o fornecimento e instalação de um porteiro eletrônico com módulo celular 4G integrado, modelo PEC 1310 C da JFL Alarmes. A solução permite que visitantes realizem chamadas diretamente para o celular do morador no momento do acionamento, possibilitando o atendimento e a liberação de acesso de qualquer localidade, sem necessidade de ramal físico, central telefônica ou interfone convencional instalado dentro da unidade.</p><p style=\"margin:0px 0px 1rem;background-color:rgb(255,255,255);\">O sistema comporta até 4.000 usuários cadastrados, com autenticação por senha, Tag RFID ou Cartão RFID, sendo possível vincular até 4 números de celular distintos por apartamento. O armazenamento de até 8.000 eventos garante rastreabilidade completa dos acessos realizados. A programação e os ajustes do equipamento são realizados remotamente via nuvem ou Bluetooth, por meio do aplicativo Programador JFL Mob, dispensando visitas técnicas para configurações futuras.</p><p style=\"margin:0px 0px 1rem;background-color:rgb(255,255,255);\">A solução conta ainda com função de intertravamento, suporte a 2 entradas para sensores de abertura de porta, 2 saídas para acionamento de fechaduras e 2 entradas para botoeiras internas, compondo um sistema completo e integrado de controle de acesso para pedestres.</p><p style=\"margin:0px 0px 1rem;background-color:rgb(255,255,255);\">Também será instalado no portão de Entrada de pedestre do condomínio , uma fechadura eletroimã, juntamente com um botão de saída e uma mola areia.</p><p style=\"background-color:rgb(255,255,255);margin-bottom:0px;\">obs.:<strong> PARA FUNCIONAMENTO DA SOLUÇÃO É NECESSÁRIA A INSERÇÃO DE UM CHIP SIM CARD COM PLANO DE DADOS ATIVO (NÃO INCLUSO NESTA PROPOSTA), CUJA CONTRATAÇÃO E CUSTEIO FICAM SOB RESPONSABILIDADE DO CONDOMÍNIO. RECOMENDA-SE PLANO DE DADOS COM FRANQUIA MÍNIMA E LIGAÇÕES ILIMITADAS PARA GARANTIR O PLENO FUNCIONAMENTO DO SISTEMA.</strong></p><p style=\"background-color:rgb(255,255,255);margin-bottom:0px;\"><br /></p><p style=\"background-color:rgb(255,255,255);margin-bottom:0px;\"><strong>OBSERÇÃO GERAL</strong></p><p style=\"background-color:rgb(255,255,255);margin-bottom:0px;\"><br /></p><p style=\"background-color:rgb(255,255,255);margin-bottom:0px;\"><strong>ATÉ A ENTREGA DA OBRA SERÁ COBRADO PELOS CONTROLES E TAGS OS VALORES:</strong></p><p style=\"background-color:rgb(255,255,255);margin-bottom:0px;\">-TAGS              -&gt;R$15,00 A UNIDADE CODIFICADA</p><p style=\"background-color:rgb(255,255,255);margin-bottom:0px;\"><br /></p><p style=\"background-color:rgb(255,255,255);margin-bottom:0px;\"><strong>APÓS A ENTRGA DA OBRA</strong></p><p style=\"background-color:rgb(255,255,255);margin-bottom:0px;\">-TAGS              -&gt;R$15,00 A UNIDADE CODIFICADA</p><p style=\"background-color:rgb(255,255,255);margin-bottom:0px;\">MAIS O SERVIÇO DE CODIFICAÇÃO DE R$100,00 POR UNIDADE ATÉ 02 UNIDADES, APÓS DUAS UNIDADES SERÁ COBRADO UM UNICO SERVIÇO DE R$200,00</p><p style=\"background-color:rgb(255,255,255);margin-bottom:0px;\"><br /></p>                    </td>\n                </tr>\n            \n            \n            \n                        <tr class=\"heading\">\n                <td colspan=\"4\">\n                    <br>\n                </td>\n            </tr>\n\n            <tr class=\"heading\">\n                <td colspan=\"3\"></td>\n                <td style=\"text-align: center\">\n                    <strong>Total: R$ 0,00</strong>\n                </td>\n            </tr>\n                    </table>\n    </div>\n</body>\n\n</html>\n','pending','2026-07-16 09:11:26','{\"From\":\"ste@steautomacaoesistemas.com.br\",\"Subject\":\"Ordem de Servi\\u00e7o - Editada\",\"Return-Path\":\"\"}'),(5532,'vilemar.ferreira@calila.com.br',NULL,NULL,'\n<!doctype html>\n<html>\n\n<head>\n    <meta charset=\"utf-8\">\n    <style>\n        .invoice-box {\n            max-width: 1100px;\n            margin: auto;\n            padding: 10px;\n            border: 1px solid #eee;\n            box-shadow: 0 0 10px rgba(0, 0, 0, .15);\n            font-size: 16px;\n            line-height: 24px;\n            font-family: \'Helvetica Neue\', \'Helvetica\', Helvetica, Arial, sans-serif;\n            color: #555;\n        }\n\n        .invoice-box table {\n            width: 100%;\n            line-height: inherit;\n            text-align: left;\n        }\n\n        .invoice-box table td {\n            padding: 5px;\n            vertical-align: top;\n        }\n\n        .invoice-box table tr td:nth-child(2) {\n            text-align: right;\n        }\n\n        .invoice-box table tr.top table td {\n            padding-bottom: 20px;\n        }\n\n        .invoice-box table tr.top table td.title {\n            font-size: 45px;\n            line-height: 45px;\n            color: #333;\n        }\n\n        .invoice-box table tr.information table td {\n            padding-bottom: 40px;\n        }\n\n        .invoice-box table tr.heading td {\n            background: #eee;\n            border-bottom: 1px solid #ddd;\n            font-weight: bold;\n        }\n\n        .invoice-box table tr.details td {\n            padding-bottom: 20px;\n        }\n\n        .invoice-box table tr.item td {\n            border-bottom: 1px solid #eee;\n        }\n\n        .invoice-box table tr.item.last td {\n            border-bottom: none;\n        }\n\n        .invoice-box table tr.total td:nth-child(2) {\n            border-top: 2px solid #eee;\n            font-weight: bold;\n        }\n\n        @media only screen and (max-width: 6