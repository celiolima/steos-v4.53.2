/*!40000 ALTER TABLE `garantias` DISABLE KEYS */;
INSERT INTO `garantias` VALUES (1,'2024-02-18','CHEQUE LIST','<p style=\"font-family: Verdana, Arial, Helvetica, sans-serif; font-size: 14px;\"><strong><span data-mce-style=\"font-size: 9.0pt; font-family: \'Tahoma\',\'sans-serif\'; mso-fareast-font-family: \'Times New Roman\'; mso-ansi-language: PT-BR; mso-fareast-language: PT-BR; mso-bidi-language: AR-SA;\" style=\"font-size: 9pt; font-family: Tahoma, &quot;sans-serif&quot;;\">ACEITAÇÃO DO SERVIÇOS:</span></strong></p><p data-mce-style=\"text-align: justify;\" style=\"font-family: Verdana, Arial, Helvetica, sans-serif; font-size: 14px; text-align: justify;\"><span data-mce-style=\"font-size: 9.0pt; font-family: \'Tahoma\',\'sans-serif\'; mso-fareast-font-family: \'Times New Roman\'; mso-ansi-language: PT-BR; mso-fareast-language: PT-BR; mso-bidi-language: AR-SA;\" style=\"font-size: 9pt; font-family: Tahoma, &quot;sans-serif&quot;;\">Eu &nbsp;____________________________________</span><span data-mce-style=\"font-size: 9.0pt; font-family: \'Tahoma\',\'sans-serif\'; mso-fareast-font-family: \'Times New Roman\'; mso-ansi-language: PT-BR; mso-fareast-language: PT-BR; mso-bidi-language: AR-SA;\" style=\"font-size: 9pt; font-family: Tahoma, &quot;sans-serif&quot;;\">&nbsp;identificado como CLIENTE, declaro para os devidos fins que recebi os&nbsp;<strong>produtos e serviços&nbsp;</strong>&nbsp;conforme listados acima e também pude verificar que o serviço realizado foi feito a contento bem como todos os testes para demonstração do perfeito funcionamento do equipamento. Caso algum problema seja verificado após a entrega, o prazo para comunicação do mesmo é de 48 horas, contados da entrega do serviço.</span></p>',1),(2,'2024-02-18','OS CLIENTE','<h3 data-mce-style=\"text-align: justify;\" style=\"color: rgb(0, 0, 0); font-family: Verdana, Arial, Helvetica, sans-serif; text-align: justify;\">Estou ciente e Concordo que após 1(um)ano a desta data cederei direito de propriedade &nbsp;do produto depositado não retirado , por \"abandono\" conformenos termos do art. 1.275 do Código Civil, podendo ser vendido como forma de pagamento pelo serviço, custos de mão de obra e peças usada na composição e execução do conserto deste equipamento.</h3><h3 data-mce-style=\"text-align: justify;\" style=\"color: rgb(0, 0, 0); font-family: Verdana, Arial, Helvetica, sans-serif; text-align: justify;\">Garantia de 90 dias após a entrega.</h3>',1);
/*!40000 ALTER TABLE `garantias` ENABLE KEYS */;
UNLOCK TABLES;

