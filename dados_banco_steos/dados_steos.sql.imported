--
-- Table structure for table `os`
--

DROP TABLE IF EXISTS `os`;
/*!40101 SET @saved_cs_client     = @@character_set_client */;
/*!50503 SET character_set_client = utf8mb4 */;
CREATE TABLE `os` (
  `idOs` int NOT NULL AUTO_INCREMENT,
  `dataAbertura` datetime DEFAULT NULL,
  `dataInicial` datetime DEFAULT NULL,
  `dataFinal` datetime DEFAULT NULL,
  `garantia` varchar(45) CHARACTER SET utf8mb4 COLLATE utf8mb4_general_ci DEFAULT NULL,
  `status` varchar(45) CHARACTER SET utf8mb4 COLLATE utf8mb4_general_ci DEFAULT NULL,
  `asaas_invoice_id` varchar(100) COLLATE utf8mb4_general_ci DEFAULT NULL,
  `asaas_invoice_status` varchar(50) COLLATE utf8mb4_general_ci DEFAULT NULL,
  `asaas_invoice_number` varchar(50) COLLATE utf8mb4_general_ci DEFAULT NULL,
  `asaas_invoice_pdf` text COLLATE utf8mb4_general_ci,
  `asaas_invoice_xml` text COLLATE utf8mb4_general_ci,
  `asaas_invoice_error` text COLLATE utf8mb4_general_ci,
  `observacoes` text CHARACTER SET utf8mb4 COLLATE utf8mb4_general_ci,
  `laudoTecnico` text CHARACTER SET utf8mb4 COLLATE utf8mb4_general_ci,
  `vendedor` varchar(50) CHARACTER SET utf8mb4 COLLATE utf8mb4_general_ci DEFAULT NULL,
  `valorTotal` decimal(10,2) DEFAULT '0.00',
  `desconto` decimal(10,2) DEFAULT '0.00',
  `valor_desconto` decimal(10,2) DEFAULT '0.00',
  `tipo_desconto` varchar(8) CHARACTER SET utf8mb4 COLLATE utf8mb4_general_ci DEFAULT NULL,
  `clientes_id` int NOT NULL,
  `usuarios_id` int NOT NULL,
  `lancamento` int DEFAULT NULL,
  `afaturar` tinyint(1) DEFAULT NULL,
  `faturado` tinyint(1) NOT NULL,
  `garantias_id` int DEFAULT NULL,
  `signature` tinytext CHARACTER SET latin1 COLLATE latin1_swedish_ci,
  `equipamentos_id` int DEFAULT NULL,
  `descricaoProduto` text CHARACTER SET utf8mb4 COLLATE utf8mb4_general_ci,
  `defeito` text CHARACTER SET utf8mb4 COLLATE utf8mb4_general_ci,
  `tipo` varchar(45) CHARACTER SET utf8mb4 COLLATE utf8mb4_general_ci DEFAULT NULL,
  `local` varchar(45) CHARACTER SET utf8mb4 COLLATE utf8mb4_general_ci DEFAULT NULL,
  `defeito_encontrado` text CHARACTER SET utf8mb4 COLLATE utf8mb4_general_ci,
  `contratos_id` int DEFAULT NULL,
  `manutPreventiva` tinyint(1) DEFAULT '0',
  PRIMARY KEY (`idOs`),
  KEY `fk_os_clientes1` (`clientes_id`),
  KEY `fk_os_usuarios1` (`usuarios_id`),
  KEY `fk_os_lancamentos1` (`lancamento`),
  KEY `fk_os_garantias1` (`garantias_id`),
  KEY `fk_os_equipamentos_1` (`equipamentos_id`),
  KEY `fk_os_contratos1` (`contratos_id`),
  KEY `idx_os_invoice_id` (`asaas_invoice_id`),
  CONSTRAINT `fk_os_clientes1` FOREIGN KEY (`clientes_id`) REFERENCES `clientes` (`idClientes`),
  CONSTRAINT `fk_os_contratos1` FOREIGN KEY (`contratos_id`) REFERENCES `contratos` (`idContratos`) ON DELETE SET NULL,
  CONSTRAINT `fk_os_equipamentos_1` FOREIGN KEY (`equipamentos_id`) REFERENCES `equipamentos` (`idEquipamentos`),
  CONSTRAINT `fk_os_lancamentos1` FOREIGN KEY (`lancamento`) REFERENCES `lancamentos` (`idLancamentos`),
  CONSTRAINT `fk_os_usuarios1` FOREIGN KEY (`usuarios_id`) REFERENCES `usuarios` (`idUsuarios`)
) ENGINE=InnoDB AUTO_INCREMENT=2531 DEFAULT CHARSET=utf8mb4 COLLATE=utf8mb4_general_ci;
/*!40101 SET character_set_client = @saved_cs_client */;

