INSERT INTO `modelos` VALUES (1,'2024-07-27','CHECKLIST','<p style=\"font-family: Verdana, Arial, Helvetica, sans-serif; font-size: 14px;\"><strong><span data-mce-style=\"font-size: 9.0pt; font-family: \'Tahoma\',\'sans-serif\'; mso-fareast-font-family: \'Times New Roman\'; mso-ansi-language: PT-BR; mso-fareast-language: PT-BR; mso-bidi-language: AR-SA;\" style=\"font-size: 9pt; font-family: Tahoma, &quot;sans-serif&quot;;\">ACEITAÇÃO DO SERVIÇOS:</span></strong></p><p data-mce-style=\"text-align: justify;\" style=\"font-family: Verdana, Arial, Helvetica, sans-serif; font-size: 14px; text-align: justify;\"><span data-mce-style=\"font-size: 9.0pt; font-family: \'Tahoma\',\'sans-serif\'; mso-fareast-font-family: \'Times New Roman\'; mso-ansi-language: PT-BR; mso-fareast-language: PT-BR; mso-bidi-language: AR-SA;\" style=\"font-size: 9pt; font-family: Tahoma, &quot;sans-serif&quot;;\">Eu &nbsp;____________________________________</span><span data-mce-style=\"font-size: 9.0pt; font-family: \'Tahoma\',\'sans-serif\'; mso-fareast-font-family: \'Times New Roman\'; mso-ansi-language: PT-BR; mso-fareast-language: PT-BR; mso-bidi-language: AR-SA;\" style=\"font-size: 9pt; font-family: Tahoma, &quot;sans-serif&quot;;\">&nbsp;identificado como CLIENTE, declaro para os devidos fins que recebi os&nbsp;<strong>produtos e serviços&nbsp;</strong>&nbsp;conforme listados acima e também pude verificar que o serviço realizado foi feito a contento bem como todos os testes para demonstração do perfeito funcionamento do equipamento. Caso algum problema seja verificado após a entrega, o prazo para comunicação do mesmo é de 48 horas, contados da entrega do serviço.</span></p>',1),(2,'2024-07-27','Contrato','<p class=\"WordSection1\">\r\n\r\n</p><p class=\"WordSection1\">\r\n\r\n</p><p class=\"WordSection1\">\r\n\r\n</p><p class=\"MsoNormal\" style=\"margin-left:333.15pt;text-align:justify;mso-line-height-alt:\r\n0pt\"><strong>INSTRUMENTO PARTICULAR &nbsp;&nbsp;PRESTAÇÃO DE SERVIÇOS&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp; &nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;QUE, &nbsp;ENTRE SI, CELEBRAM </strong><strong><span style=\"font-size: 8pt; font-family: Arial, sans-serif; color: rgb(51, 51, 51); background-image: initial; background-position: initial; background-size: initial; background-repeat: initial; background-attachment: initial; background-origin: initial; background-clip: initial;\"> {{cliente1}} E</span></strong><strong> STE SISTEMAS.<o:p></o:p></strong></p>\r\n\r\n<p class=\"MsoNormal\" style=\"line-height:14.6pt;mso-line-height-rule:exactly\"><span style=\"font-size:12.0pt;mso-bidi-font-size:10.0pt;font-family:\" times=\"\" new=\"\" roman\",serif;=\"\" mso-fareast-font-family:\"times=\"\" roman\";mso-bidi-font-family:arial\"=\"\">&nbsp;</span></p>\r\n\r\n<p class=\"MsoNormal\"><strong><u>CONTRATANTE</u>: </strong><strong><span style=\"font-size: 8pt; font-family: Arial, sans-serif; color: rgb(51, 51, 51); background-image: initial; background-position: initial; background-size: initial; background-repeat: initial; background-attachment: initial; background-origin: initial; background-clip: initial;\"> {{cliente2}} </span></strong>inscrita no CNPJ:<strong><span style=\"font-size: 8pt; font-family: Arial, sans-serif; color: rgb(51, 51, 51); background-image: initial; background-position: initial; background-size: initial; background-repeat: initial; background-attachment: initial; background-origin: initial; background-clip: initial;\"> 07.796.043/0001-74</span></strong>,<strong> </strong>com endereço na <strong><span style=\"font-size: 8pt; font-family: Arial, sans-serif; color: rgb(51, 51, 51); background-image: initial; background-position: initial; background-size: initial; background-repeat: initial; background-attachment: initial; background-origin: initial; background-clip: initial;\">R BARAO DE ARACATI</span></strong><span style=\"font-size:8.0pt;font-family:\r\n\" arial\",sans-serif;mso-fareast-font-family:\"times=\"\" new=\"\" roman\"\"=\"\">, 444 - </span><strong><span style=\"font-size: 8pt; font-family: Arial, sans-serif; color: rgb(51, 51, 51); background-image: initial; background-position: initial; background-size: initial; background-repeat: initial; background-attachment: initial; background-origin: initial; background-clip: initial;\">MEIRELES</span></strong><span style=\"font-size:8.0pt;font-family:\" arial\",sans-serif;=\"\" mso-fareast-font-family:\"times=\"\" new=\"\" roman\"\"=\"\">– FORTALEZA/CE</span>, CEP <strong><span style=\"font-size: 8pt; font-family: Arial, sans-serif; color: rgb(51, 51, 51); background-image: initial; background-position: initial; background-size: initial; background-repeat: initial; background-attachment: initial; background-origin: initial; background-clip: initial;\">60.115-080 </span></strong>doravante denominado de <strong>CONTRATANTE</strong>;<span style=\"font-size:12.0pt;font-family:\" roboto=\"\" condensed\";=\"\" mso-fareast-font-family:\"times=\"\" new=\"\" roman\";mso-bidi-font-family:\"times=\"\" roman\"\"=\"\"><o:p></o:p></span></p>\r\n\r\n<p class=\"MsoNormal\" style=\"line-height:17.1pt;mso-line-height-rule:exactly\"><u><span style=\"font-size:12.0pt;mso-bidi-font-size:10.0pt;font-family:\" times=\"\" new=\"\" roman\",serif;=\"\" mso-fareast-font-family:\"times=\"\" roman\";mso-bidi-font-family:arial\"=\"\">&nbsp;</span></u></p>\r\n\r\n<p class=\